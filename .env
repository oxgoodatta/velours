# ── APP IDENTITY (change APP_NAME and it reflects everywhere) ──────────────────
APP_NAME=Velours
APP_TAGLINE=Digital Products. Endless Possibilities.
APP_URL=https://yourdomain.com
SECRET_KEY=change-this-to-something-long-and-random

# ── TWO ADMIN ACCOUNTS ────────────────────────────────────────────────────────
ADMIN1_NAME=Admin One
ADMIN1_EMAIL=admin1@velours.com
ADMIN1_PASSWORD=admin1

ADMIN2_NAME=Admin Two
ADMIN2_EMAIL=admin2@velours.com
ADMIN2_PASSWORD=admin2

# ── HUBTEL KEYS (from unity.hubtel.com/account/api-accounts-add) ──────────────
HUBTEL_CLIENT_ID=your-client-id
HUBTEL_CLIENT_SECRET=your-client-secret
HUBTEL_MERCHANT_ACCOUNT=HM000000
HUBTEL_CALLBACK_URL=https://yourdomain.com/payment/callback

# ── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///velours.db
